{
  "name": "depenspect",
  "version": "0.0.5",
  "description": "Inspect deprecated versions for npm packages.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoisclebs/depenspect.git"
  },
  "bugs": {
    "url": "https://github.com/whoisclebs/depenspect/issues"
  },
  "homepage": "https://github.com/whoisclebs/depenspect#readme",
  "scripts": {
    "build": "tsup lib/main/index.ts --format cjs --dts --sourcemap --clean --out-dir dist",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --passWithNoTests --no-cache --runInBand",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watch",
    "test:staged": "npm test -- --findRelatedTests",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "commit:lint": "commitlint --edit"
  },
  "author": "Clebson Augusto",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/rc": "^1.2.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.4",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "rc": "^1.2.8"
  }
}
